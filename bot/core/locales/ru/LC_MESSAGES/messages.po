#: bot/core/ui_info.py:44
msgid "//delete"
msgstr "//едлите"

#: bot/core/ui_info.py:46
msgid ""
"Hello! I'm a text-generating bot based on your chat and a great "
"conversationalist (sometimes)."
msgstr ""
"Привет! Я бот, генерирующий текст, основываясь на текущем чате, и "
"отличный собеседник (иногда)."

#: bot/core/ui_info.py:48
#, python-brace-format
msgid "cha...{DELETED}-bot"
msgstr "ча...{УДАЛЕНО}-бот"

#: bot/core/middlewares/throttling.py:64
msgid "Stop spamming!"
msgstr "Прекрати спамить!"

#: bot/core/middlewares/throttling.py:65
msgid "How much information..."
msgstr "Как много информации..."

#: bot/core/middlewares/throttling.py:66
msgid "Ahhh..."
msgstr "АААА..."

#: bot/handlers/other.py:33
msgid "hello!"
msgstr "привет!"

#: bot/handlers/commands/play/uno/misc/filter.py:259 bot/handlers/other.py:34
